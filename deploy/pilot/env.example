# Copy to deploy/pilot/private/.env (chmod 600); use shell-compatible values.
OPENGYM_HOSTNAME=gym.example.com
# Required: matching successful fork publication, pinned by manifest digest.
OPENGYM_API_IMAGE=ghcr.io/orbenda83/opengym-api@sha256:REPLACE_WITH_SCANNED_DIGEST
OPENGYM_WEB_IMAGE=ghcr.io/orbenda83/opengym-web@sha256:REPLACE_WITH_SCANNED_DIGEST
OPENGYM_PROJECT_NAME=opengym-pilot
OPENGYM_WEB_PORT=8082
# Keep enabled for initial password sign-in; set 0 after adding and testing passkeys.
OPENGYM_PASSWORD_LOGIN=1
